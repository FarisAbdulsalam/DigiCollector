<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Collections</title>
    <%- include('../partials/_head') %>
</head>
<body>
    <%- include('../partials/_navbar') %>

        <div class="container">
            <h1 class="mb-4">All Collections</h1>
            <div class="row">
                <% collections.forEach(collection => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title"> <%= collection.collectionName %> </h5>
                                <p class="text-muted"> <%= collection.owner.username %> </p>
                                <a href="/cardCollections/<%= collection._id %>" class="btn btn-outline-primary">View Collection</a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
        <%- include('../partials/_footer') %>
</body>

</html>