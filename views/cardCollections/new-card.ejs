<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a Card</title>
    <%- include('../partials/_head') %>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <div class="container mt-5" style="max-width: 600px;">
            <h2 class="mb-4">Add a New Card</h2>
            <form action="/cardCollections/add-cards" method="POST">
                <div class="mb-3">
                    <label class="form-label">Name:</label>
                    <input type="text" class="form-control" name="name" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Card ID:</label>
                    <input type="text" class="form-control" name="cardId" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Image URL:</label>
                    <input type="url" class="form-control" name="image">
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity:</label>
                    <input type="number" class="form-control" name="quantity" min="1" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Price:</label>
                    <input type="number" class="form-control" name="price" min="0" step="0.01" required>
                </div>
                <button type="submit" class="btn btn-success">Add Card</button>
            </form>
        </div>
    <%- include('../partials/_footer') %>
</body>

</html>