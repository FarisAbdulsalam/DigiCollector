<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Collection</title>
  <%- include('../partials/_head') %>
</head>

<body>
  <%- include('../partials/_navbar') %>
    <div class="container">
      <h1> <%= collection.collectionName %> </h1>
      <a href="/cardCollections/new-card" class="btn btn-primary mb-4">Add Card</a>
      <form action="/cardCollections/delete-collection?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you wish to delete this collection? This action cannot be undone.')">
        <button class="btn btn-danger">Delete Collection</button>
      </form>
      <br>
      <% if (collection && collection.cards && collection.cards.length === 0) { %>
        <p class="text-muted">Collection is empty. Add cards to view them here!</p>
        <% } else if (collection && collection.cards) { %>
          <div class="row">
            <% collection.cards.forEach(card => { %>
              <div class="col-md-3 mb-4">
                <div class="card h-100">
                  <img src="<%= card.image %>" class="card-img-top" alt="<%= card.name %>">
                  <div class="card-body">
                    <h5 class="card-title"> <%= card.name %> </h5>
                    <p class="card-text">ID: <%= card.cardId %><br>Quantity: <%= card.quantity %><br>Price: $<%= card.price %></p>
                    <div class="d-flex justify-content-between">
                      <a href="/cardCollections/cards/<%= card._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                      <form action="/cardCollections/cards/<%= card._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Are you sure you wish to delete this card? This action cannot be undone.')">
                        <button class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
          <% } else { %>
              <p>Error: No collection found.</p>
          <% } %>
          <ul class="list-group">
              <% collection.comments.forEach(comment => { %>
                <li class="list-group-item">
                  <strong>
                    <%= comment.author.username %>
                  </strong>
                  <small class="float-end"> <%= new Date(comment.timestamp).toLocaleString('en-GB', { year: 'numeric' , month: '2-digit' , day: '2-digit' , hour: '2-digit' , minute: '2-digit' , hour12: false }) %> </small>
                  <p> <%= comment.text %> </p>
                </li>
              <% }) %>
          </ul>
    </div>
    <%- include('../partials/_footer') %>
</body>

</html>