<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Collection</title>
    <%- include('../partials/_head') %>
</head>
<body>
<%- include('../partials/_navbar') %>

    <div class="container mt-5" style="max-width: 500px;">
        <h2 class="text-center mb-4">Create Your Digimon card Collection</h2>
        <form action="/cardCollections" method="POST">
            <div class="mb-3">
                <input type="text" name="collectionName" class="form-control" placeholder="Collection Name" required/>
            </div>
            <button type="submit" class="btn btn-success w-100">Create Collection</button>
        </form>
    </div>
    <%- include('../partials/_footer') %>
</body>
</html>